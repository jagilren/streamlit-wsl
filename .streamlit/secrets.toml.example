# Plantilla de secrets para Streamlit Cloud y desarrollo local.
#
# Uso local:
#   1. Copia este archivo a .streamlit/secrets.toml
#   2. Rellena los valores reales
#   3. NO lo commitees (ya está en .gitignore)
#
# Uso en Streamlit Cloud:
#   En share.streamlit.io → tu app → Settings → Secrets,
#   pega el contenido (ya rellenado) en el editor de secrets.

DB_HOST = "4.tcp.ngrok.io"
DB_PORT = 20916
DB_NAME = "ptar_db"
DB_USER = "postgres"
DB_PASSWORD = "cambia-esto"
